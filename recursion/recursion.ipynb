   "source": [
    "def recursion(n):\n",
    "    if n <= 1:\n",
    "        return n\n",
    "    else:\n",
    "        return recursion(n - 1) + recursion(n - 2)\n",
    "\n",
    "result = recursion(5)\n",
    "print(recursion(10))\n",
    "print(result)"
   ]
